[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://mmo/presentation/ui/GameplayInputGate.cs" id="1_gate"]
[ext_resource type="Script" path="res://addons/godot_state_charts/state_chart.gd" id="2_chart"]
[ext_resource type="Script" path="res://addons/godot_state_charts/compound_state.gd" id="3_compound"]
[ext_resource type="Script" path="res://addons/godot_state_charts/atomic_state.gd" id="4_atomic"]
[ext_resource type="Script" path="res://addons/godot_state_charts/transition.gd" id="5_transition"]

[node name="GameplayInputGate" type="Node"]
script = ExtResource("1_gate")

[node name="StateChart" type="Node" parent="."]
script = ExtResource("2_chart")

[node name="Root" type="Node" parent="StateChart" node_paths=PackedStringArray("initial_state")]
script = ExtResource("3_compound")
initial_state = NodePath("Gameplay")

[node name="Gameplay" type="Node" parent="StateChart/Root"]
script = ExtResource("4_atomic")

[node name="CaptureUi" type="Node" parent="StateChart/Root/Gameplay" node_paths=PackedStringArray("to")]
script = ExtResource("5_transition")
to = NodePath("../../UiCaptured")
event = &"ui_capture"

[node name="UiCaptured" type="Node" parent="StateChart/Root"]
script = ExtResource("4_atomic")

[node name="ReleaseUi" type="Node" parent="StateChart/Root/UiCaptured" node_paths=PackedStringArray("to")]
script = ExtResource("5_transition")
to = NodePath("../../Gameplay")
event = &"ui_release"
